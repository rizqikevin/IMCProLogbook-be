# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
HTTP_ADDR=:8080

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://logbook:logbook@localhost:5432/logbook?sslmode=disable
DATABASE_MAX_CONNS=10

# ─── Storage ──────────────────────────────────────────────────────────────────
# "local" for development, "s3" for production
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./data/uploads

# S3 / MinIO (only required when STORAGE_DRIVER=s3)
#S3_BUCKET=logbook-dev
#AWS_REGION=us-east-1
#S3_ENDPOINT=http://localhost:9000
#S3_PATH_STYLE=true
# Credentials via env (alternative: ~/.aws/credentials or IAM role)
#AWS_ACCESS_KEY_ID=minioadmin
#AWS_SECRET_ACCESS_KEY=minioadmin

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (scheme+host only, no trailing slash)
# Leave empty to disable CORS (same-origin requests still work)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Limits ───────────────────────────────────────────────────────────────────
MAX_REQUEST_BYTES=104857600       # 100 MB total multipart body
MAX_PHOTO_BYTES=10485760          # 10 MB per photo
MAX_IMAGE_PIXELS=40000000         # ~40 MP
MAX_PHOTOS_PER_UPLOAD=20          # photos per single upload request
MAX_PHOTOS_PER_LOGBOOK=100        # photos per logbook entry
MAX_CONCURRENT_UPLOADS=4          # parallel upload slots

# ─── Timeouts ─────────────────────────────────────────────────────────────────
SESSION_TTL=12h
REQUEST_TIMEOUT=2m
SHUTDOWN_TIMEOUT=30s

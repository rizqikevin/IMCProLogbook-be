# Compose reads storage settings below; other app settings remain inline in Compose.
# No .env is required for local storage. Also usable for manual execution.
# Generate a hex password with: openssl rand -hex 32
# Existing databases must keep their current password unless the role is updated.
POSTGRES_PASSWORD=
APP_ENV=production
WEB_PORT=18472

# Set only when preserving an existing Compose project name during migration.
#COMPOSE_PROJECT_NAME=machine-logbook

# Photos persist in the uploads Docker volume on this machine.
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./data/uploads

# Optional Cloudflare R2 storage. Keep local until credentials and file copy are ready.
# Endpoint is account-level, without a bucket suffix. Preserve the archieve/ spelling.
S3_BUCKET=imcp-logbook
AWS_REGION=auto
S3_ENDPOINT=https://cc1cc266785ec408f8915028bde01b99.r2.cloudflarestorage.com
S3_PATH_STYLE=true
S3_KEY_PREFIX=archieve/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional, only for temporary credentials that require a session token.
AWS_SESSION_TOKEN=

# Same-origin frontend/API works without a CORS allowlist.
CORS_ALLOWED_ORIGINS=
# Optional Compose connector: docker compose --profile tunnel up -d
TUNNEL_TOKEN=

SESSION_TTL=12h
MAX_REQUEST_BYTES=100000000
MAX_PHOTO_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
MAX_PHOTOS_PER_UPLOAD=20
MAX_PHOTOS_PER_LOGBOOK=100
MAX_CONCURRENT_UPLOADS=4
REQUEST_TIMEOUT=2m
SHUTDOWN_TIMEOUT=30s

# Only for running Go directly outside Docker. Compose sets these internally.
#DATABASE_URL=postgres://logbook:PASSWORD@localhost:5432/logbook?sslmode=disable
#HTTP_ADDR=:18473

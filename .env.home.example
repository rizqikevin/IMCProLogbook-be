# Copy to .env.home on the Linux server. Do not commit .env.home.
# Use a hex password (openssl rand -hex 32), safe inside DATABASE_URL.
POSTGRES_PASSWORD=
PUBLIC_ORIGIN=https://logbook.example.com
WEB_PORT=3000

# Existing S3-compatible bucket over HTTPS (AWS S3, R2, or your own service).
S3_BUCKET=
AWS_REGION=auto
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_PATH_STYLE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Only needed if using the optional Compose tunnel service.
TUNNEL_TOKEN=

SESSION_TTL=12h
MAX_CONCURRENT_UPLOADS=4
